# Cloudinary — 圖片上傳（必填，上傳功能依賴此服務）
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=draft-gallery

# Supabase — 跨裝置同步（速記本＋教學資源）
# 請至 Supabase Dashboard → Settings → API 複製以下兩個值
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key（公開金鑰，無安全疑慮）
# 以下為 Service Role Key，僅 server-side 使用，絕不暴露前端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key（請至 Dashboard → Settings → API 複製）

# 匿名簽入啟用方式：
# 1. 前往 Supabase Dashboard → Authentication → Providers → Anonymous Sign-ins → 啟用
# 2. 在 Supabase SQL Editor 執行 supabase/migrations/001_user_data_sync.sql
# 3. 或執行：update auth.config set enable_anonymous_sign_ins = true;
